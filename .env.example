# Copie para .env (na raiz do projeto) e ajuste. Todas as variáveis são opcionais.

# Onde ficam o banco SQLite e os anexos.
# Padrão no Windows: %LOCALAPPDATA%\OrganizadorDeTarefas\data (fora do OneDrive). Em outros sistemas: ./data
# DATA_DIR=

# Fuso padrão do servidor (o navegador informa o fuso de cada pessoa)
APP_TIMEZONE=America/Sao_Paulo

# Endereço público do app (links no resumo diário e no calendário .ics), ex.: https://tarefas.suaempresa.com
PUBLIC_URL=

# Geração de etapas por IA (RF52). Sem chave, o botão de IA fica oculto.
# Atenção: título e descrição da tarefa são enviados à API da Anthropic. Confirme a política da empresa antes de ativar.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_TIMEOUT_S=10
# AI_ENABLED=true   # use se as credenciais vierem do perfil do `ant auth login`, sem ANTHROPIC_API_KEY

# Resumo diário por e-mail (RF56)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Resumo diário pelo Telegram (RF56): token do bot criado com o @BotFather
TELEGRAM_BOT_TOKEN=

# Limite por anexo, em MB
MAX_UPLOAD_MB=20

# Agendador do resumo diário (desligue em instâncias extras)
SCHEDULER_ENABLED=true
